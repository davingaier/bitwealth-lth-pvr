# --- Supabase Postgres (use the Session pooler URI, port 5432, from Project Settings → Database) ---
DATABASE_URL=postgresql://postgres.wqnmxpooabmedvtackji:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Identity ---
TA_BOT_ORG_ID=b0a77009-03b9-44a1-ae1d-34f157d44a8b
TA_BOT_WORKER_ID=local-dev

# --- Market data (always mainnet: real prices even when tenants trade on testnet) ---
BYBIT_PUBLIC_ENV=mainnet
# Comma-separated timeframes to stream/backfill for tracked instruments
TA_BOT_TIMEFRAMES=1m,5m,15m,1h,4h,1d
# Backfill depth in days per timeframe (JSON)
TA_BOT_BACKFILL_DAYS={"1m":7,"5m":30,"15m":90,"1h":365,"4h":730,"1d":1825}

# --- Dev-only Bybit TESTNET key for the smoke test (tenants' keys live in Supabase Vault) ---
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# --- Ops ---
HEALTH_PORT=8080
LOG_LEVEL=info
