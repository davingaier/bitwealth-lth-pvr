{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --env-file=.env worker/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read worker/main.ts",
    "check": "deno check worker/main.ts worker/cli/*.ts",
    "test": "deno test --allow-net --allow-env --allow-read worker/",
    "backfill": "deno run --allow-net --allow-env --allow-read --env-file=.env worker/cli/backfill.ts",
    "instruments": "deno run --allow-net --allow-env --allow-read --env-file=.env worker/cli/sync_instruments.ts",
    "smoke": "deno run --allow-net --allow-env --allow-read --env-file=.env worker/cli/testnet_smoke.ts",
    "analyze": "deno run --allow-net --allow-env --allow-read --env-file=.env worker/cli/analyze.ts"
  },
  "imports": {
    "postgres": "npm:postgres@3.4.5",
    "zod": "npm:zod@3.23.8",
    "@std/assert": "jsr:@std/assert@1"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": { "lineWidth": 110 },
  "lint": { "rules": { "tags": ["recommended"] } }
}
